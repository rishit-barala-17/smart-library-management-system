<div class="container-fluid">
  <div class="row flex-nowrap">
    <%- include('../partials/admin-sidebar') %>
    <div class="col py-3">
      <div class="container mb-5">
        <div class="row mb-4">
          <div class="col">
            <h1 class="display-6"><%= title %></h1>
            <p class="text-muted">Analyze waitlist demand to guide future book procurements.</p>
          </div>
        </div>

        <div class="row mb-4">
          <!-- Summary Cards -->
          <div class="col-md-3">
            <div class="card text-white bg-primary mb-3 shadow-sm h-100">
              <div class="card-body">
                <h5 class="card-title">Active Waitlisted Titles</h5>
                <p class="card-text display-4"><%= summary.totalWithWaitlist %></p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card text-white mb-3 shadow-sm h-100" style="background-color: #6f42c1;">
              <div class="card-body">
                <h5 class="card-title">Total Waitlist Requests</h5>
                <p class="card-text display-4"><%= summary.totalWaitlistSlots %></p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card text-white bg-danger mb-3 shadow-sm h-100">
              <div class="card-body">
                <h5 class="card-title">Total Critical (Ratio>1)</h5>
                <p class="card-text display-4"><%= summary.criticalCount %></p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card text-white mb-3 shadow-sm h-100 <%= summary.actionRequired ? 'bg-danger' : 'bg-success' %>">
              <div class="card-body">
                <h5 class="card-title">Action Required</h5>
                <p class="card-text display-4"><%= summary.actionRequired ? 'Yes' : 'No' %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-0">
            <% if (analytics.length === 0) { %>
              <div class="p-5 text-center text-muted">
                <h4>No books currently have a waitlist.</h4>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Title</th>
                      <th>ISBN</th>
                      <th class="text-center">Total Owned</th>
                      <th class="text-center">Available</th>
                      <th class="text-center">Borrowed</th>
                      <th class="text-center">Waitlist</th>
                      <th class="text-center">Demand Ratio</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% analytics.forEach(item => { 
                        let bgClass = '';
                        let borderStyle = '';
                        let textClass = 'fw-bold';
                        
                        if (item.demandRatio > 2) {
                          bgClass = '#fef2f2';
                          borderStyle = 'border-left: 4px solid red;';
                          textClass = 'text-danger fw-bold';
                        } else if (item.demandRatio > 1) {
                          bgClass = '#fff7ed';
                          borderStyle = 'border-left: 4px solid orange;';
                          textClass = 'text-warning fw-bold';
                        } else {
                          bgClass = 'transparent';
                          borderStyle = 'border-left: 4px solid transparent;';
                        }
                    %>
                    <tr style="background-color: <%= bgClass %>; <%= borderStyle %>">
                      <td><%= item.title %></td>
                      <td><%= item.isbn %></td>
                      <td class="text-center"><%= item.totalCopies %></td>
                      <td class="text-center"><%= item.availableCopies %></td>
                      <td class="text-center"><%= item.borrowedCopies %></td>
                      <td class="text-center"><%= item.waitlistSize %></td>
                      <td class="text-center <%= textClass %>"><%= item.demandRatio %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
