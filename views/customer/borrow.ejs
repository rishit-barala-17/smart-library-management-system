<div class="container mt-5 mb-5">
  <div class="row">
    <div class="col-md-8 text-center mx-auto">
      <div class="bg-light border rounded-3 p-5">
        <h1 class="display-4 mb-5">Borrow Books</h1>
        <div class="table-responsive-md pb-3">
          <table class="table table-hover text-center">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Cover Image</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              <% cartItems.filter(item => item.user.id === user.id).map((item, i) => { %>
                <tr>
                  <th scope="row"><%= ++i %></th>
                  <th><img src="<%= item.book.coverImagePath %>" alt="<%= item.book.title %>" width="75" height="100"></th>
                  <td><%= item.book.title %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% if (cartItems.filter(item => item.user.id === user.id).length > 0) { %>
            <form action="/borrow" method="POST" class="row g-3 text-start">
              <input type="hidden" name="user_id" value="<%= user.id %>">
              <div class="col-md-6">
                <label for="borrowDate" class="form-label">Borrow Date</label>
                <input type="date" class="form-control" id="borrowDate" name="borrowDate" readonly>
              </div>
              <div class="col-md-6">
                <label for="returnDate" class="form-label">Return Date</label>
                <input type="date" class="form-control" id="returnDate" name="returnDate" required>
              </div>
              <% if (typeof errors !== 'undefined') { %>
                <% errors.forEach(err => { %>
                  <% if (err.param === 'returnDate') { %>
                    <p class="text-danger fw-bold mb-0"><%= err.msg %></p>
                  <% } %>
                <% }) %>
              <% } %>
              <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-0">
                <a href="/cart" class="btn btn-outline-secondary">Back to Cart</a>
                <button type="submit" class="btn btn-outline-primary">Confirm Borrow</button>
              </div>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Read-only Library Location Maps (one per book in cart) -->
<% if (cartItems.filter(item => item.user.id === user.id).length > 0) { %>
<div class="container mb-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h5 class="fw-semibold mb-3 text-muted" style="letter-spacing:0.04em;">📚 Where to find your books</h5>

      <% cartItems.filter(item => item.user.id === user.id).forEach(item => { %>
        <div class="mb-4">
          <p class="fw-semibold mb-2" style="font-size:0.9rem;">
            <span class="text-muted">Book:</span> <%= item.book.title %>
            <% if (item.book.location_section) { %>
              &nbsp;·&nbsp;
              <span class="text-muted" style="font-size:0.8rem;">
                <%= item.book.location_section %> › Row <%= item.book.location_shelf %> › <%= item.book.location_side %> Side › Column <%= item.book.location_column %>
              </span>
            <% } %>
          </p>

          <% if (item.book.location_section) { %>
            <div class="lib-map-wrapper" data-book-id="<%= item.book.id %>"
              data-section="<%= item.book.location_section %>"
              data-shelf="<%= item.book.location_shelf %>"
              data-column="<%= item.book.location_column %>"
              data-side="<%= item.book.location_side %>">

              <div class="lib-map-title">📍 Physical Location — Read Only</div>

              <!-- Section cards (read-only) -->
              <div class="lib-map-sections">
                <% const bookSection = item.book.location_section; %>
                <div class="lib-section-card lib-section-card--readonly <%= bookSection === 'Science & Medicine'  ? 'selected' : '' %>" style="background:#c8e6f9;">
                  <div class="lib-section-icon">🔬</div>
                  <div class="lib-section-name">Science &amp; Medicine</div>
                  <div class="lib-section-row">Row A</div>
                </div>
                <div class="lib-section-card lib-section-card--readonly <%= bookSection === 'Fiction & Literature' ? 'selected' : '' %>" style="background:#c8f0d8;">
                  <div class="lib-section-icon">📖</div>
                  <div class="lib-section-name">Fiction &amp; Literature</div>
                  <div class="lib-section-row">Row B</div>
                </div>
                <div class="lib-section-card lib-section-card--readonly <%= bookSection === 'Arts & Humanities'   ? 'selected' : '' %>" style="background:#f9e8c8;">
                  <div class="lib-section-icon">🎨</div>
                  <div class="lib-section-name">Arts &amp; Humanities</div>
                  <div class="lib-section-row">Row C</div>
                </div>
                <div class="lib-section-card lib-section-card--readonly <%= bookSection === 'History & Biography' ? 'selected' : '' %>" style="background:#ede0f5;">
                  <div class="lib-section-icon">🏛️</div>
                  <div class="lib-section-name">History &amp; Biography</div>
                  <div class="lib-section-row">Row D</div>
                </div>
                <div class="lib-section-card lib-section-card--readonly <%= bookSection === 'Lifestyle & General' ? 'selected' : '' %>" style="background:#fde8e8;">
                  <div class="lib-section-icon">🌿</div>
                  <div class="lib-section-name">Lifestyle &amp; General</div>
                  <div class="lib-section-row">Row E</div>
                </div>
              </div>

              <!-- Grid (always visible, readonly) -->
              <div class="lib-map-grid-wrap visible">
                <div class="lib-map-grid-header">
                  <span class="lib-map-grid-label">Shelf Grid — Row <%= item.book.location_shelf %>, Column <%= item.book.location_column %> highlighted</span>
                </div>

                <!-- Column axis labels (rendered by JS) -->
                <div class="lib-map-axis-row mb-1">
                  <div class="lib-map-row-label" style="border:none;background:transparent;"></div>
                  <div class="lib-map-col-labels lib-col-labels-ro"></div>
                </div>

                <!-- Shelf rows (rendered by JS per wrapper) -->
                <div class="lib-shelf-rows-ro"></div>
              </div>

              <!-- Auto-shown confirmation banner -->
              <div class="lib-map-confirm-banner lib-map-confirm-banner--readonly visible">
                <span class="lib-map-confirm-icon">📌</span>
                <span>
                  Location: <strong><%= item.book.location_section %></strong>
                  &nbsp;→&nbsp; Row <strong><%= item.book.location_shelf %></strong>
                  &nbsp;→&nbsp; <strong><%= item.book.location_side %></strong> Side
                  &nbsp;→&nbsp; Column <strong><%= item.book.location_column %></strong>
                </span>
              </div>

            </div><!-- .lib-map-wrapper -->
          <% } else { %>
            <div class="alert alert-warning" style="font-size:0.85rem;">
              No physical location has been assigned to this book yet.
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<% } %>


<script>
  const getDate = () => {
    let today = new Date()
    let dd = today.getDate()
    let mm = today.getMonth() + 1   // +1 because start from 0
    let yyyy = today.getFullYear()
    
    if(dd < 10) {
        dd = '0' + dd
    } 
    if(mm < 10) {
        mm = '0' + mm
    } 

    today = yyyy + '-' + mm + '-' + dd;
    // console.log(today);
    console.log(new Date() - new Date())
    document.getElementById("borrowDate").value = today;
  }

  window.onload = function() {
    getDate();
  };
</script>

<script>
/* ══════════════════════════════════════════════════════
   READ-ONLY LIBRARY MAP — User Borrow View
   Builds shelf grid for each .lib-map-wrapper[data-section]
══════════════════════════════════════════════════════ */
(function() {
  const SECTIONS_RO = [
    { name: 'Science & Medicine',  shelf: 'A', color: '#c8e6f9' },
    { name: 'Fiction & Literature',shelf: 'B', color: '#c8f0d8' },
    { name: 'Arts & Humanities',   shelf: 'C', color: '#f9e8c8' },
    { name: 'History & Biography', shelf: 'D', color: '#ede0f5' },
    { name: 'Lifestyle & General', shelf: 'E', color: '#fde8e8' }
  ];

  document.querySelectorAll('.lib-map-wrapper[data-section]').forEach(wrapper => {
    const targetSection = wrapper.dataset.section;
    const targetShelf   = wrapper.dataset.shelf;
    const targetColumn  = parseInt(wrapper.dataset.column, 10);
    const targetSide    = wrapper.dataset.side;

    /* Build column axis labels */
    const colLabelContainer = wrapper.querySelector('.lib-col-labels-ro');
    if (colLabelContainer && colLabelContainer.children.length === 0) {
      for (let c = 1; c <= 35; c++) {
        const d = document.createElement('div');
        d.className = 'lib-map-col-label-cell';
        d.textContent = c;
        colLabelContainer.appendChild(d);
      }
    }

    /* Build shelf rows */
    const shelfContainer = wrapper.querySelector('.lib-shelf-rows-ro');
    if (!shelfContainer) return;
    shelfContainer.innerHTML = '';

    SECTIONS_RO.forEach(sec => {
      ['Front', 'Back'].forEach((side, sideIdx) => {
        const rowEl = document.createElement('div');
        rowEl.className = 'lib-shelf-row';

        const rowLbl = document.createElement('div');
        rowLbl.className = 'lib-map-row-label';
        rowLbl.textContent = sec.shelf;
        rowLbl.title = `${sec.name} — ${side}`;
        rowEl.appendChild(rowLbl);

        const grid = document.createElement('div');
        grid.className = 'lib-shelf-grid';

        for (let c = 1; c <= 35; c++) {
          const cell = document.createElement('div');
          cell.className = 'lib-cell lib-cell--readonly';
          cell.style.backgroundColor = sec.color;

          const isTarget = (
            sec.name   === targetSection &&
            sec.shelf  === targetShelf   &&
            c          === targetColumn  &&
            side       === targetSide
          );

          if (isTarget) {
            cell.classList.add('active-cell');
          }

          /* Non-target sections dimmed */
          if (sec.name !== targetSection) {
            cell.style.opacity = '0.3';
          }

          cell.title = `${sec.name} › ${side} › Row ${sec.shelf} › Col ${c}`;
          grid.appendChild(cell);
        }
        rowEl.appendChild(grid);
        shelfContainer.appendChild(rowEl);

        /* Divider between front/back, not after back */
        if (sideIdx === 0) {
          const div = document.createElement('div');
          div.className = 'lib-shelf-divider';
          shelfContainer.appendChild(div);
        }
      });

      /* Gap between sections */
      const gap = document.createElement('div');
      gap.style.height = '8px';
      shelfContainer.appendChild(gap);
    });
  });
})();
</script>