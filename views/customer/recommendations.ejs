<div class="container my-5">
  <%- include('../partials/_messages') %>

  <div class="mb-4">
    <h2>Recommended For You</h2>
    <p class="text-muted" style="margin-bottom: 4px;">Personalised picks using Jaccard Similarity — J(A,B) = |A∩B| / |A∪B|</p>
    <small class="text-muted"><%= totalFound %> books matched your taste profile</small>
  </div>

  <details class="mb-5 border p-3 rounded bg-light">
    <summary class="fw-bold" style="cursor: pointer;">How does this work?</summary>
    <div class="mt-3 text-muted small">
      <p class="mb-2">Our recommendation engine personalizes your experience by analyzing your reading habits:</p>
      <ul class="mb-0">
        <li><strong>User History (Set A):</strong> We look at the genres of the books you've borrowed.</li>
        <li><strong>Candidate Genres (Set B):</strong> We compare them against the genres of unread books.</li>
        <li><strong>Jaccard Similarity:</strong> We calculate the overlap using J(A,B) = |A∩B| / |A∪B|.</li>
        <li><strong>Frequency Weight:</strong> Books from genres you read more frequently get a higher score.</li>
        <li><strong>Cold Start:</strong> If you've borrowed less than 3 books, we fall back to the genres you selected in your profile.</li>
      </ul>
    </div>
  </details>

  <% if (totalFound === 0) { %>
    <div class="text-center py-5 my-5 bg-light rounded border border-dashed">
      <h4 class="mb-3">Your recommendations are waiting</h4>
      <p class="text-muted mb-4">Borrow a few books to unlock your personalised picks.</p>
      <a href="/books" class="btn btn-primary px-4">Browse Books</a>
    </div>
  <% } else { %>

    <% if (strongMatch && strongMatch.length > 0) { %>
      <div class="mt-5">
        <h4 class="mb-1">Strong Matches</h4>
        <p class="text-muted mb-4 small">Books in the genres you read most</p>
        <div class="row">
          <% strongMatch.forEach(item => { %>
            <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 12rem;">
              <%- include('../partials/_book_card', { book: item.book, user: typeof user !== 'undefined' ? user : null, prev_url: '/recommendations' }) %>
              <div class="text-center mt-2 small text-primary fw-bold"><%= item.matchPercent %>% match</div>
              <div class="text-center small text-muted fst-italic"><%= item.reason %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (partialMatch && partialMatch.length > 0) { %>
      <div class="mt-5">
        <h4 class="mb-1">You Might Like</h4>
        <p class="text-muted mb-4 small">Other genres from your reading history</p>
        <div class="row">
          <% partialMatch.forEach(item => { %>
            <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 12rem;">
              <%- include('../partials/_book_card', { book: item.book, user: typeof user !== 'undefined' ? user : null, prev_url: '/recommendations' }) %>
              <div class="text-center mt-2 small text-primary fw-bold"><%= item.matchPercent %>% match</div>
              <div class="text-center small text-muted fst-italic"><%= item.reason %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (trending && trending.length > 0) { %>
      <div class="mt-5">
        <h4 class="mb-1">Trending Outside Your Reads</h4>
        <p class="text-muted mb-4 small">Highly popular books in unexplored genres</p>
        <div class="row">
          <% trending.forEach(item => { %>
            <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 12rem;">
              <%- include('../partials/_book_card', { book: item.book, user: typeof user !== 'undefined' ? user : null, prev_url: '/recommendations' }) %>
              <div class="text-center mt-2 small text-warning fw-bold"><%= item.book.popularityScore %>/10 popularity</div>
              <div class="text-center small text-muted fst-italic"><%= item.reason %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

  <% } %>
</div>

<!-- Book Detail Modal -->
<% const allItems = [...(strongMatch || []), ...(partialMatch || []), ...(trending || [])] %>
<% allItems.forEach(item => { const book = item.book; %>
  <div class="modal fade" id="bookDetailModal<%= book._id %>" tabindex="-1" aria-labelledby="bookDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookDetailModalLabel">Book Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="container-fluid">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <img src="<%= book.cover_image.startsWith('/') ? book.cover_image : '/public/images/' + book.cover_image %>" class="img-fluid" onerror="this.onerror=null; this.src='/public/images/default_book.svg';">
                    </div>
                    <div class="col-md">
                        <ul class="list-group">
                            <li class="list-group-item"><h4><%= `${book.title}` %></h4></li>
                            <li class="list-group-item"><strong>ISBN : </strong> <%= book.isbn %></li>
                            <li class="list-group-item"><strong>Author : </strong> <%= book.author %></li>
                            <li class="list-group-item"><strong>Genre : </strong> <%= book.genre %></li>
                            <li class="list-group-item"><strong>Description : </strong> <br> <%= book.description %></li>
                        </ul>
                    </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
  </div>
<% }) %>
