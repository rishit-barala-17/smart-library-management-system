<% if (url !== user.id) { %>
  <div class="display-5 text-center mt-3">Unauthorized Access</div>
<% } else { %>
  <div class="display-5 text-center mt-3 mb-4">My Book</div>
  <div class="container mb-4">
    <% if (typeof activeReservation !== 'undefined' && activeReservation) { %>

📚 You have an active reservation!
<%= activeReservation.title %> by <%= activeReservation.author %>


Reserved until: <%= activeReservation.reservedUntil.toLocaleString() %>

Claim Your Reserved Copy


<% } %>

<% if (typeof myWaitlist !== 'undefined'
       && myWaitlist.length > 0) { %>
<div style="margin-bottom:2rem; padding:1.5rem; max-width:800px; margin-left:auto; margin-right:auto;
  background:#fff; border-radius:12px;
  box-shadow:0 1px 4px rgba(0,0,0,0.08)">

  <h5 style="margin:0 0 1rem; font-weight:700;
    color:#1e293b; font-size:1.2rem">
    Your Waitlist
    <span style="font-size:0.9rem; font-weight:400;
      color:#64748b; margin-left:6px">
      (<%= myWaitlist.length %>
      book<%= myWaitlist.length > 1 ? 's' : '' %>)
    </span>
  </h5>

  <div style="display:flex; flex-direction:column; gap:10px">
    <% myWaitlist.forEach(item => { %>
    <div style="display:flex; align-items:center; gap:14px;
      padding:14px 16px; border-radius:10px; border:1px solid;
      <%= item.isNext
        ? 'background:#fefce8; border-color:#fde047'
        : item.isClose
          ? 'background:#eff6ff; border-color:#bfdbfe'
          : 'background:#f8fafc; border-color:#e2e8f0' %>">

      <img src="<%= item.book.coverImagePath %>"
           style="width:50px; height:70px; object-fit:cover;
             border-radius:4px; flex-shrink:0"
           onerror="this.onerror=null; this.src='/public/images/default_book.svg';">

      <div style="flex:1; min-width:0">
        <p style="margin:0 0 4px; font-weight:600;
          font-size:16px; color:#0f172a; overflow:hidden;
          text-overflow:ellipsis; white-space:nowrap">
          <%= item.book.title %>
        </p>
        <p style="margin:0 0 2px; font-size:14px;
          color:#64748b"><%= item.book.author %></p>
        <p style="margin:0 0 6px; font-size:13px;
          color:#94a3b8"><%= item.book.genre %></p>
        <p style="margin:0; font-size:13px; color:#64748b;
          font-style:italic">
          <%= item.checkBackTip %>
        </p>
      </div>

      <div style="text-align:right; flex-shrink:0">
        <div style="font-size:1.6rem; font-weight:800;
          <%= item.isNext ? 'color:#854d0e'
            : item.isClose ? 'color:#1d4ed8'
            : 'color:#475569' %>">
          #<%= item.position %>
        </div>
        <div style="font-size:13px; color:#64748b;
          margin-top:2px; font-weight:600">
          <%= item.isNext ? 'You\'re next!'
            : item.estimatedText %>
        </div>
        <% if (!item.isNext) { %>
        <div style="font-size:12px; color:#94a3b8;
          margin-top:2px">
          <%= item.peopleAhead %> ahead ·
          avg <%= item.avgLoanDays %>d/borrow
        </div>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <p style="margin:10px 0 0; font-size:12px;
    color:#94a3b8; text-align:right">
    * Estimates use actual return dates + historical
    average loan duration for each book
  </p>
</div>
<% } %>

    <div class="row d-flex justify-content-center">
      <%- include('../partials/_messages') %>
      <% if(borrowedBook.length === 0) { %>
        <p class="text-center mb-0">No borrowed books yet.</p>
      <% } %>
      <% borrowedBook.forEach(history => { %>
        <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 12rem;">
          <div class="card">
            <img src="<%= history.borrowed_book.coverImagePath %>" id="img-pointer" class="card-img mt-2" alt="<%= history.borrowed_book.title %>" data-bs-toggle="modal" data-bs-target="#bookDetailModal<%= history.borrowed_book.id %>">
            <div class="card-body">
              <h5 class="card-title fs-6" id="book_title" title="<%= history.borrowed_book.title %>"><%= history.borrowed_book.title %></h5>
              <form class="cart d-grid mx-auto mb-0" action="/return" method="POST">
                <% if (user) { %>
                  <input type="hidden" name="user_id" value="<%= user.id %>">
                <% } %>
                <input type="hidden" name="book_id" value="<%= history.borrowed_book.id %>">
                <input type="hidden" name="history_id" value="<%= history.id %>">
                <button class="btn btn-outline-success btn-sm mb-1" type="button" data-bs-toggle="modal" data-bs-target="#readBookModal<%= history.borrowed_book.id %>">Read Book</button>
                <button class="btn btn-outline-primary btn-sm" type="submit" onclick="return confirm('Are you sure to return this book earlier than the due date?')">Return Book</button>
              </form>
              <%
                let date = new Date()
                date.setDate(date.getDate() - 1)
                const remainingTime = Math.floor((history.return_date - date) / (3600 * 24 * 1000))
              %>
              <div class="text-center form-text">
                <% if (remainingTime === 0) { %>
                  Last day today!
                <% } else { %>
                  <%= remainingTime %> day(s) remaining
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- BEGIN RECOMMENDATIONS CAROUSEL -->
    <style>
      .reco-section { margin-top:2.5rem; padding-top:1.5rem; border-top:2px solid #e2e8f0 }
      .reco-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem }
      .reco-title { font-size:1.1rem; font-weight:700; color:#1e293b; margin:0 }
      .reco-see-all { font-size:0.8rem; color:#2563eb; text-decoration:none }
      .reco-carousel { display:flex; gap:1rem; overflow-x:auto; padding-bottom:1rem; scrollbar-width:thin }
      .reco-card { min-width:14rem; max-width:14rem; flex-shrink:0; }
    </style>
    
    <% if (typeof topRecommendations !== 'undefined' && topRecommendations.length > 0) { %>
    <div class="reco-section">
      <div class="reco-header"><h4 class="reco-title">Recommended For You</h4><a href="/recommendations" class="reco-see-all">See all 20 picks →</a></div>
      <div class="reco-carousel">
        <% topRecommendations.forEach(item => { %>
        <div class="reco-card">
          <%- include('../partials/_book_card', { book: item.book, user: typeof user !== 'undefined' ? user : null, prev_url: '/inventory/' + user.id }) %>
          <% if (item.matchPercent > 0) { %>
            <div class="text-center mt-2 small text-primary fw-bold"><%= item.matchPercent %>% match</div>
          <% } else { %>
            <div class="text-center mt-2 small text-warning fw-bold"><%= item.book.popularityScore %>/10 popularity</div>
          <% } %>
          <div class="text-center small text-muted fst-italic"><%= item.reason %></div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div style="margin-top:2rem; padding:1rem; background:#f8fafc; border-radius:8px; border:1px dashed #cbd5e1; text-align:center; color:#94a3b8; font-size:14px">
    📚 Borrow a few books to unlock personalised recommendations. <a href="/books" style="color:#2563eb; margin-left:4px">Browse the library →</a>
    </div>
    <% } %>
    <!-- END RECOMMENDATIONS CAROUSEL -->

  </div>
<% } %>

<!-- Book Detail Modal -->
<% borrowedBook.forEach(book => { %>
  <div class="modal fade" id="bookDetailModal<%= book.borrowed_book.id %>" tabindex="-1" aria-labelledby="bookDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookDetailModalLabel">Book Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="container-fluid">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <img src="<%= book.borrowed_book.coverImagePath %>" class="img-fluid">
                    </div>
                    <div class="col-md">
                        <ul class="list-group">
                            <li class="list-group-item"><h4><%= `${book.borrowed_book.title} (${book.borrowed_book.publish_year})` %></h4></li>
                            <li class="list-group-item"><strong>Stock : </strong> <%= book.borrowed_book.stock %></li>
                            <li class="list-group-item"><strong>ISBN : </strong> <%= book.borrowed_book.isbn %></li>
                            <li class="list-group-item"><strong>Author : </strong> <%= book.borrowed_book.author %></li>
                            <li class="list-group-item"><strong>Page Count : </strong> <%= book.borrowed_book.page_count %> pages</li>
                            <li class="list-group-item"><strong>Genre : </strong> <%= book.borrowed_book.genre %></li>
                            <li class="list-group-item"><strong>Description : </strong> <br> <%= book.borrowed_book.description %></li>
                        </ul>
                    </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
  </div>
<% }) %>

<!-- Read Book Modal -->
<% borrowedBook.forEach(book => { %>
  <div class="modal fade" id="readBookModal<%= book.borrowed_book.id %>" tabindex="-1" aria-labelledby="readBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="readBookModalLabel"><%= book.borrowed_book.title %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="container-fluid">
                <div class="row">
                  <p><%= book.borrowed_book.description %></p>
                </div>
              </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
  </div>
<% }) %>

<!-- Recommendations Book Detail Modal -->
<% if (typeof topRecommendations !== 'undefined' && topRecommendations.length > 0) { %>
  <% topRecommendations.forEach(item => { const book = item.book; %>
    <div class="modal fade" id="bookDetailModal<%= book._id %>" tabindex="-1" aria-labelledby="bookDetailModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title" id="bookDetailModalLabel">Book Detail</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="container-fluid">
                  <div class="row">
                      <div class="col-md-3 mb-3">
                          <img src="<%= book.cover_image.startsWith('/') ? book.cover_image : '/public/images/' + book.cover_image %>" class="img-fluid" onerror="this.onerror=null; this.src='/public/images/default_book.svg';">
                      </div>
                      <div class="col-md">
                          <ul class="list-group">
                              <li class="list-group-item"><h4><%= `${book.title}` %></h4></li>
                              <li class="list-group-item"><strong>ISBN : </strong> <%= book.isbn %></li>
                              <li class="list-group-item"><strong>Author : </strong> <%= book.author %></li>
                              <li class="list-group-item"><strong>Genre : </strong> <%= book.genre %></li>
                              <li class="list-group-item"><strong>Description : </strong> <br> <%= book.description %></li>
                          </ul>
                      </div>
                  </div>
                </div>
              </div>
              <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
              </div>
          </div>
      </div>
    </div>
  <% }) %>
<% } %>